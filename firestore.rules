rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.globalRole == 'super_admin';
    }

    // Chat is always available to anyone with project access — the legacy
    // features.chat flag has been retired (no UI toggle, no gate).

    // accessKeys is a flat set of user uids with project access (creator ∪ lead ∪
    // project-role holders ∪ hierarchy-role-actor holders ∪ attached-team leads ∪
    // task assignees). Team membership is no longer an access vector, so the old
    // `accessKeys.hasAny(u.teamIds)` clause has been dropped — a direct uid match
    // is the whole story.
    function hasProjectAccess(projectId) {
      let p = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return isSuperAdmin()
          || request.auth.uid in p.accessKeys;
    }

    function validNewMessage() {
      return request.resource.data.authorId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.serverUpdatedAt == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000;
    }

    // A time entry carries a positive whole number of minutes and a bare
    // calendar day ('YYYY-MM-DD'), never a timestamp — see the TimeEntry type.
    function validTimeEntry() {
      return request.resource.data.minutes is int
          && request.resource.data.minutes >= 1
          && request.resource.data.dateKey is string
          // Month 01-12, day 01-31 — not full calendar validation (Firestore
          // rules can't check e.g. Feb 30), but rejects the obviously bogus
          // groupings a direct write could otherwise smuggle in.
          && request.resource.data.dateKey.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && (!('note' in request.resource.data)
              || (request.resource.data.note is string
                  // .size() on a string counts UTF-8 BYTES, not JS characters —
                  // the 500-char client input can therefore be up to ~2000
                  // bytes for multi-byte text (CJK, emoji), so the cap here
                  // must be sized in bytes, not mirror the character count.
                  && request.resource.data.note.size() <= 2000));
    }

    function validEdit() {
      return request.resource.data.authorId == resource.data.authorId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.serverUpdatedAt == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000;
    }

    // ─── Chat subcollection ──────────────────────────────────────────────

    match /projects/{projectId}/chat/{messageId} {
      allow read: if isSignedIn()
                  && hasProjectAccess(projectId);

      allow create: if isSignedIn()
                    && hasProjectAccess(projectId)
                    && validNewMessage();

      allow update: if isSignedIn()
                    && hasProjectAccess(projectId)
                    && request.auth.uid == resource.data.authorId
                    && validEdit();

      allow delete: if false;
    }

    // ─── /config/orgStructure ────────────────────────────────────────────
    // Tenant-configured org shape (lead-role name, team-role toggles, work
    // types, allotment, setupCompleted). Phase 1: any signed-in user can
    // read (every client needs the labels and resolver inputs at boot);
    // only super_admins can write — via the setup wizard or /admin/config.

    match /config/orgStructure {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ─── /workflows/{workflowId} ─────────────────────────────────────────
    // Phase 2a: workflow shape (stages, actions, transitions) lives in
    // Firestore so it's editable without a code release. Every signed-in
    // user reads (the engine needs the doc to render the banner and gate
    // actions); only super_admins write — via seed scripts today, via the
    // authoring wizard in 2c. Top-level collection so document paths stay
    // valid (config/<id> already occupies the singleton slot).
    //
    // Phase 2b adds /workflows/_registry as a sentinel singleton tracking
    // which workflows are active for the tenant. It rides the same rule:
    // signed-in users read (the picker / dashboard tabs need it); only
    // super_admins write (activation toggles, default selection). Workflow
    // ids never start with `_` so collisions are impossible.

    match /workflows/{workflowId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ─── /timeEntries/{entryId} ──────────────────────────────────────────
    // Per-task time logs (features.timeTracking). A time entry is a personal
    // fact: only its owner may create it (uid is pinned to the caller), and
    // only its owner or a super_admin may correct or remove it. Reads stay
    // open to any signed-in user because the /admin/time report aggregates
    // across everyone.
    //
    // Proportionate hygiene, not a security boundary — the blanket rule below
    // still lets any signed-in client write tasks/ and auditEvents/ directly.
    // Sandbox builds write to sandbox/{visitorUid}/timeEntries, which this
    // match does not cover; the sandbox ruleset handles those (same as chat).

    match /timeEntries/{entryId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
                    && validTimeEntry()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.createdAt == request.time;

      allow update: if isSignedIn()
                    && validTimeEntry()
                    && (resource.data.uid == request.auth.uid || isSuperAdmin())
                    // Ownership and creation time are immutable.
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isSignedIn()
                    && (resource.data.uid == request.auth.uid || isSuperAdmin());
    }

    // ─── Everything else — unchanged blanket rule ───────────────────────
    // This preserves your current behavior for users/, projects/, tasks/, etc.
    // Tighten these later as part of your productization work.

    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
