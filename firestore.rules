rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.globalRole == 'super_admin';
    }

    // Chat is always available to anyone with project access — the legacy
    // features.chat flag has been retired (no UI toggle, no gate).

    // accessKeys is a flat set of user uids with project access (creator ∪ lead ∪
    // project-role holders ∪ hierarchy-role-actor holders ∪ attached-team leads ∪
    // task assignees). Team membership is no longer an access vector, so the old
    // `accessKeys.hasAny(u.teamIds)` clause has been dropped — a direct uid match
    // is the whole story.
    function hasProjectAccess(projectId) {
      let p = get(/databases/$(database)/documents/projects/$(projectId)).data;
      return isSuperAdmin()
          || request.auth.uid in p.accessKeys;
    }

    function validNewMessage() {
      return request.resource.data.authorId == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.serverUpdatedAt == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000;
    }

    function validEdit() {
      return request.resource.data.authorId == resource.data.authorId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.serverUpdatedAt == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000;
    }

    // ─── Chat subcollection ──────────────────────────────────────────────

    match /projects/{projectId}/chat/{messageId} {
      allow read: if isSignedIn()
                  && hasProjectAccess(projectId);

      allow create: if isSignedIn()
                    && hasProjectAccess(projectId)
                    && validNewMessage();

      allow update: if isSignedIn()
                    && hasProjectAccess(projectId)
                    && request.auth.uid == resource.data.authorId
                    && validEdit();

      allow delete: if false;
    }

    // ─── /config/orgStructure ────────────────────────────────────────────
    // Tenant-configured org shape (lead-role name, team-role toggles, work
    // types, allotment, setupCompleted). Phase 1: any signed-in user can
    // read (every client needs the labels and resolver inputs at boot);
    // only super_admins can write — via the setup wizard or /admin/config.

    match /config/orgStructure {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ─── /workflows/{workflowId} ─────────────────────────────────────────
    // Phase 2a: workflow shape (stages, actions, transitions) lives in
    // Firestore so it's editable without a code release. Every signed-in
    // user reads (the engine needs the doc to render the banner and gate
    // actions); only super_admins write — via seed scripts today, via the
    // authoring wizard in 2c. Top-level collection so document paths stay
    // valid (config/<id> already occupies the singleton slot).
    //
    // Phase 2b adds /workflows/_registry as a sentinel singleton tracking
    // which workflows are active for the tenant. It rides the same rule:
    // signed-in users read (the picker / dashboard tabs need it); only
    // super_admins write (activation toggles, default selection). Workflow
    // ids never start with `_` so collisions are impossible.

    match /workflows/{workflowId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ─── Everything else — unchanged blanket rule ───────────────────────
    // This preserves your current behavior for users/, projects/, tasks/, etc.
    // Tighten these later as part of your productization work.

    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
